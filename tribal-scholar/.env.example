# TribalScholar AI - Environment Variables (Prototype)
# Copy to .env and adjust

# Backend
DATABASE_URL=sqlite:///./tribal_scholar.db
# For PostgreSQL use: postgresql://user:password@localhost:5432/tribalscholar
SECRET_KEY=change-me-to-a-strong-random-secret-key-demo-only-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# OCR
TESSERACT_CMD=/usr/bin/tesseract
